#include "DlsHeader.idl"
#include "Vec3.idl"

module dls2_interface
{
  module msg
  {
    struct ControlDebug
    {
      dls2_interface::msg::DlsHeader header;

      string robot_name;

      double base_position[3];
      double base_orientation[4];
      sequence<double> joints_position;

      dls2_interface::msg::Vec3 desired_linear_velocity;
      dls2_interface::msg::Vec3 desired_angular_velocity;

      sequence<dls2_interface::msg::Vec3> current_feet_positions_world;
      sequence<dls2_interface::msg::Vec3> estimated_grf_world;

      // One MPC interval: base at k+1; feet, nominal GRF and contacts at k.
      sequence<dls2_interface::msg::Vec3> predicted_base_positions;
      sequence<dls2_interface::msg::Vec3> predicted_feet_positions;
      sequence<dls2_interface::msg::Vec3> predicted_grf_horizon;
      sequence<boolean> predicted_contact_state_horizon;

      unsigned long horizon;
      unsigned long contacts_per_step;

      double terrain_height_world;
      double terrain_roll;
      double terrain_pitch;
      // Friction coefficient used by the MPC.
      double mu;
      // Calculated joint torques in Nm with full MPC GRF, before enable blending, indexed like joints_position.
      sequence<double> current_desired_torques;
      // Measured controller inputs after simulated noise and drift.
      double dp[3];
      double omega[3];
      // Riccati feedback K (x - x0) added to the MPC GRF, in N, world frame, per leg; zero when not applied.
      sequence<dls2_interface::msg::Vec3> riccati_grf_world;
      // Filtered Fmax in N at MPC stage zero, in robotlib leg order.
      double fmax[4];
      // Viscous + Coulomb compensation in Nm, before torque limits/blending, indexed like joints_position; zero when not applied.
      sequence<double> friction_torques;
      // Acados time_tot in seconds for the last completed MPC solve; zero before the first solve.
      double mpc_solve_time_s;
      // Whole-body CoM in m, world frame, from the measured base pose and joints (CoM offset included).
      dls2_interface::msg::Vec3 com_position_world;
      // MPC CoM in m, world frame, at the same stage as predicted_base_positions; equals com_position_world without an MPC prediction.
      dls2_interface::msg::Vec3 desired_com_position_world;
    };
  };
};
