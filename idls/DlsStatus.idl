#include "ProcessStatus.idl"
#include "ReferenceLight.idl"
#include "DlsRobotStateLight.idl"
#include "DlsHeader.idl"
#include "CSBasicCommand.idl"

module dls2_interface {
	module msg {
		struct DlsStatus
		{
			dls2_interface::msg::DlsHeader header;

			sequence<dls2_interface::msg::ProcessStatus> processes; 
			dls2_interface::msg::ReferenceLight reference; // followed by controller
			dls2_interface::msg::DlsRobotStateLight robot_state;
			dls2_interface::msg::CSBasicCommand cs_command_feedback; // last command received from the control station (echo)
			dls2_interface::msg::CSBasicCommand cs_command_state; // modes actually applied by the orchestrator; enable = false only for a rover-side STOP
		};
	};
};