module dls2_interface
{
  module msg
  {
    struct ControlSignal
    {
      // header
      string frame_id;
      unsigned long sequence_id;
      double timestamp;

      uint8 control_mode;

      sequence<double> joints_position;
      sequence<double> joints_velocity;
      sequence<double> joints_torques;
      sequence<double> kp;
      sequence<double> kd;
    };
  };
};
